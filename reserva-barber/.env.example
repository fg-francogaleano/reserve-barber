# Reserva Barber — environment variables
# Copy this file to `.env` (for Prisma CLI / next dev) and `.dev.vars` (for wrangler preview).
# NEVER commit real values. Production secrets are set with `wrangler secret put <NAME>`.

# Runtime connection — Supabase Supavisor pooler (transaction mode, port 6543).
# Used by the app at runtime (driver adapter). Format:
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres"

# Direct connection — used ONLY by `prisma migrate` / `prisma db seed` (port 5432).
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth — project URL and anon/publishable key (safe to expose client-side).
# Find both under Project Settings -> API in the Supabase dashboard.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Build-time secret (NOT a runtime one — `wrangler secret put` will not do).
# Server Action ids derive from this key plus the action's file path and export
# name. Without it Next.js generates a fresh key per build, so every deploy
# invalidates the Server Actions of any browser tab that is already open and the
# user gets "Server action not found" until they reload.
#
# Rules:
#   - Must be IDENTICAL for every build of this app (yours, a teammate's, CI).
#     A build with a different key ships different ids and the problem returns.
#   - Base64, 16/24/32 bytes. Generate with:
#       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   - It encrypts data Server Actions send to the client — treat it as a secret
#     and never commit the real value.
# See docs/s0-versions-decision.md for the measurements behind this.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="YOUR_BASE64_KEY"

# Used ONLY when running `npm run provision-owner` — NEVER add these to .env/.dev.vars:
# SUPABASE_SERVICE_ROLE_KEY, OWNER_EMAIL, OWNER_INITIAL_PASSWORD (pass inline on the command line)
