# Reserva Barber — environment variables
# Copy this file to `.env` (for Prisma CLI / next dev) and `.dev.vars` (for wrangler preview).
# NEVER commit real values. Production secrets are set with `wrangler secret put <NAME>`.

# Runtime connection — Supabase Supavisor pooler (transaction mode, port 6543).
# Used by the app at runtime (driver adapter). Format:
# postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres"

# Direct connection — used ONLY by `prisma migrate` / `prisma db seed` (port 5432).
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth — project URL and anon/publishable key (safe to expose client-side).
# Find both under Project Settings -> API in the Supabase dashboard.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Build-time secret (NOT a runtime one — `wrangler secret put` will not do).
# Server Action ids derive from this key plus the action's file path and export
# name. Without it Next.js generates a fresh key per build, so every deploy
# invalidates the Server Actions of any browser tab that is already open and the
# user gets "Server action not found" until they reload.
#
# Rules:
#   - Must be IDENTICAL for every build of this app (yours, a teammate's, CI).
#     A build with a different key ships different ids and the problem returns.
#   - Base64, 16/24/32 bytes. Generate with:
#       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   - It encrypts data Server Actions send to the client — treat it as a secret
#     and never commit the real value.
# See docs/s0-versions-decision.md for the measurements behind this.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="YOUR_BASE64_KEY"

# Encrypts `PaymentConfig.mpAccessToken` at rest (PC2). A RUNTIME secret, so in
# production it is set with `wrangler secret put PAYMENT_CREDENTIALS_KEY`.
#
# Rules:
#   - Exactly 32 bytes, base64. Generate with:
#       node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   - The SAME value must be in `.env` and `.dev.vars`, or a credential saved
#     under `next dev` cannot be read under `npm run preview`.
#   - Upload it as EXACT BYTES — pipe from a file or from node's stdout, never
#     from a shell echo. A byte-order mark or a trailing newline is invisible in
#     the terminal and corrupts the key; for DATABASE_URL that surfaced during S0
#     as an unrelated connection error, and here it surfaces as stored
#     credentials that cannot be decrypted.
#   - Losing or rotating it without re-encrypting makes every stored Mercado Pago
#     credential permanently unreadable. Recovery is the owner pasting them again.
#   - Validated at the Mercado Pago page's composition root, NOT in the global
#     env check, so a deploy that forgets it breaks that page alone.
PAYMENT_CREDENTIALS_KEY="YOUR_BASE64_32_BYTE_KEY"

# The app's own public origin, used to build ABSOLUTE URLs: the shareable link
# on /perfil, and the canonical + OpenGraph tags on the public profile /b/[slug].
#
# Not a secret — it is the address printed on the link clients receive. Production
# sets it in `wrangler.jsonc` under `vars`, not with `wrangler secret put`, so a
# deploy from a fresh clone cannot silently lack it.
#
# The value differs per environment because the ports differ:
#   .env       -> http://localhost:3000   (next dev)
#   .dev.vars  -> http://localhost:8787   (wrangler preview)
#
# /perfil tolerates its absence by falling back to the request's Host header.
# **/b/[slug] deliberately does not** (B1 design D3): on a page anonymous
# visitors open, the Host header is supplied by a stranger, and a forged one
# would make a shop advertise someone else's origin. The cost of that strictness
# is that without this variable the public page renders but emits no canonical
# URL and no OpenGraph tags — every link shared to WhatsApp or Instagram loses
# its preview, with no error and no log to notice it by.
APP_ORIGIN="http://localhost:3000"

# Used ONLY when running `npm run provision-owner` — NEVER add these to .env/.dev.vars:
# SUPABASE_SERVICE_ROLE_KEY, OWNER_EMAIL, OWNER_INITIAL_PASSWORD (pass inline on the command line)
