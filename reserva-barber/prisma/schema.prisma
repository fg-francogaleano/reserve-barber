// Prisma schema — single source of truth for the database schema.
// See docs/data-model.md for entity definitions.
// Connection URLs live in prisma.config.ts (Prisma 7 convention).

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  runtime       = "workerd"
  // Prisma ships two builds of the wasm query compiler and defaults to "fast"
  // for every runtime except `vercel-edge`. On workerd that default does not
  // fit: "fast" is 3591 KiB and "small" is 1809 KiB, against a Worker script
  // limit of 3 MiB that the rest of the bundle already fills most of.
  compilerBuild = "small"
}

// CLI-only client (seed, provisioning scripts). The `workerd` target above
// generates a wasm query compiler instantiated the way Cloudflare's workerd
// runtime expects; Node's own ESM loader cannot satisfy those wasm-bindgen
// imports when run via `tsx`. This generator targets Node instead — it is
// never imported by application code that ships to the Worker.
generator cliClient {
  provider = "prisma-client"
  output   = "../src/generated/prisma-cli"
}

datasource db {
  provider = "postgresql"
}

/// The single administrative user of the system. Authentication is handled by
/// Supabase Auth (email/password, sign-ups disabled); this table never stores
/// credentials. `authUserId` maps to `auth.users.id` and is set by
/// `scripts/provision-owner.ts`, never by application code.
model Owner {
  id              String           @id @default(cuid())
  email           String           @unique @db.VarChar(255)
  authUserId      String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  locations       Location[]
  services        Service[]
  clients         Client[]
  // Optional, and it stays optional: no profile row exists until the owner
  // saves the editor for the first time. The absence is a normal state the
  // editor renders as an empty form, not an error (data-model.md §2).
  businessProfile BusinessProfile?
  // Same shape, same reason: the payment configuration row is created by the
  // owner's first save from any of PC1/PC2/PC3, so its absence is the normal
  // initial state rather than an error (PC1 design D1).
  paymentConfig   PaymentConfig?
}

/// The public-facing brand shown to clients at `/b/{publicSlug}`. Brand-level
/// rather than per-location: the client picks a branch inside the booking flow
/// (data-model.md §2).
///
/// Ownership is STORED, like Service and unlike Barber: `ownerId` is a real
/// column, so every read and write scopes on it directly rather than through a
/// relation join.
model BusinessProfile {
  id           String       @id @default(cuid())
  ownerId      String       @unique
  owner        Owner        @relation(fields: [ownerId], references: [id])
  businessName String       @db.VarChar(120)
  bio          String?      @db.VarChar(1000)
  photoUrl     String?
  coverUrl     String?
  // Normalized before persistence — lowercased, diacritics stripped, hyphenated
  // — so this index compares already-canonical values. The index compares raw
  // bytes; a case-insensitive column type is deliberately NOT used to
  // compensate for values that should have arrived canonical (design D10).
  publicSlug   String       @unique @db.VarChar(60)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  socialLinks  SocialLink[]
}

/// A single social network link displayed on the public profile
/// (data-model.md §3).
model SocialLink {
  id                String          @id @default(cuid())
  businessProfileId String
  // Cascade for the same reason as BarberService: the row IS the relationship
  // and has no meaning without either endpoint. Inert while the application has
  // no hard-delete path — declared so it is already correct when one arrives.
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  url               String          @db.VarChar(500)
  orderIndex        Int
  // No updatedAt: the set is replaced as a whole inside one transaction rather
  // than edited row by row, the same write shape as WorkingHours. An additive
  // write would double the set on a retry after a committed-but-timed-out save.
  createdAt         DateTime        @default(now())

  // One link per platform per profile. Also what bounds the set at seven
  // without a separate count, and what makes a retried insert a constraint
  // violation rather than a duplicate.
  @@unique([businessProfileId, platform])
  // Backs the ordered read behind the editor and the public profile.
  @@index([businessProfileId, orderIndex])
}

/// The platforms a public profile can link to (data-model.md §3).
enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  X
  YOUTUBE
  WEBSITE
}

/// A physical barbershop branch owned by the Owner.
model Location {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id])
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barbers   Barber[]

  // The authoritative guarantee against duplicate names, per data-model.md §4.
  // Application-level checking cannot be it: the check and the write are two
  // round trips against a transaction-mode pooler and may not share a
  // connection. Names are normalized before persistence, so this compares
  // already-canonical values.
  @@unique([ownerId, name])
  // Backs the dashboard list query, which always filters by owner.
  @@index([ownerId, isActive])
}

/// A barber working at a specific Location.
/// Ownership is derived through location.ownerId — no ownerId column (data-model.md §5, design D1).
model Barber {
  id           String          @id @default(cuid())
  locationId   String
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  displayName  String          @db.VarChar(120)
  bio          String?         @db.VarChar(500)
  avatarUrl    String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  services     BarberService[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  bookings     Booking[]

  // Uniqueness is per location, not per owner: the same first name at two
  // branches is legitimate; two identically-named barbers at one branch cannot
  // be told apart in the booking flow (data-model.md §5, design D2).
  @@unique([locationId, displayName])
  // Backs the dashboard list and the active-barber-at-location query.
  @@index([locationId, isActive])
}

/// A bookable service offered by the business, with a price and a duration.
/// Unlike Barber, ownership is STORED: `ownerId` is a real column, so every
/// read and write scopes on it directly rather than through a relation join
/// (data-model.md §6, design D2).
model Service {
  id              String          @id @default(cuid())
  ownerId         String
  owner           Owner           @relation(fields: [ownerId], references: [id])
  name            String          @db.VarChar(120)
  description     String?         @db.VarChar(500)
  // Explicit precision and scale — NEVER Prisma's default Decimal(65,30).
  // The column is deliberately wider than the application maximum
  // (9,999,999.99) so a numeric overflow, which PostgreSQL raises as an
  // untyped error, is unreachable by construction (design D4).
  price           Decimal         @db.Decimal(12, 2)
  durationMinutes Int
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  barbers         BarberService[]
  bookings        Booking[]

  // Uniqueness is per owner, not per location: a service is offered by the
  // business as a whole and Service has no location relation (design D9).
  @@unique([ownerId, name])
  // Backs the dashboard list and the active-only count behind the cap.
  @@index([ownerId, isActive])
}

/// Join entity linking barbers to the services they can perform. Presence of a
/// row is what makes a service bookable with a given barber — this table, not
/// Service, is the gate to the public booking flow (data-model.md §7).
///
/// The same-owner rule is NOT expressible here: Barber has no ownerId column
/// (ownership is derived through location), so no composite foreign key,
/// unique constraint or CHECK can compare the two sides. It is enforced at
/// write time in BarberServiceAssignmentService, which is therefore the ONLY
/// permitted writer of this table (M4 design D6).
model BarberService {
  id        String   @id @default(cuid())
  barberId  String
  // Cascade, unlike Barber → Location's Restrict: there the child carries data
  // of its own that must not vanish silently, here the row IS the relationship
  // and has no meaning without either endpoint. Inert while the application has
  // no hard-delete path — declared so it is already correct when one arrives
  // (design D7).
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // No updatedAt: the row carries no mutable field, so an assignment is created
  // or destroyed, never edited.
  createdAt DateTime @default(now())

  @@unique([barberId, serviceId])
  // Required IN ADDITION to the composite unique above, which only serves the
  // barberId-leading direction. The bookability read and B2's "which barbers
  // perform this service" query both lead with the service.
  @@index([serviceId])
}

/// A recurring weekly working window for a barber, consumed by slot generation.
///
/// `startMinute` / `endMinute` are minutes from midnight in BUSINESS LOCAL TIME
/// — wall clock, never an instant and never offset at rest (data-model.md §8).
/// A recurring schedule states a clock face; storing an offset would let a
/// change in civil time silently reinterpret what the owner said.
///
/// No `updatedAt`: the write replaces the barber's whole week inside one
/// transaction rather than editing rows. A working window has no natural
/// business key, so an additive write would double the week on a retry after a
/// committed-but-timed-out save (design D4).
model WorkingHours {
  id          String   @id @default(cuid())
  barberId    String
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday, in the BUSINESS calendar — never the runtime's.
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())

  // Deliberately NOT (barberId, dayOfWeek). The editor offers one window per
  // day today, but the split shift (9–13, 16–20) is the common local pattern
  // and data-model.md §8 permits it. Keeping the wider key means restoring the
  // second window is a UI change, not a migration over live data (design D3).
  @@unique([barberId, dayOfWeek, startMinute])
  // Backs the editor read and the slot generation lookup, both of which lead
  // with the barber and filter by day.
  @@index([barberId, dayOfWeek])
}

/// A period in which a barber is unavailable, overriding the recurring
/// WorkingHours (data-model.md §9).
///
/// The range is HALF-OPEN: [startsAt, endsAt). The start is inside the absence,
/// the end is not — matching Booking's [startTime, endTime) on purpose. If the
/// two disagreed, a booking beginning exactly when an absence ends would be
/// blocked or allowed depending on which rule ran first, and that surfaces as a
/// mysterious unbookable slot rather than as a failing test.
///
/// `@db.Timestamptz` is deliberate and load-bearing: Prisma's default for
/// DateTime is a zone-LESS `TIMESTAMP`, which is harmless for createdAt and
/// wrong for anything compared against a human's clock. An absence is a point in
/// time, so it obeys the stored-time convention — UTC, zone-aware column.
///
/// Named startsAt/endsAt rather than startDate/endDate because the earlier
/// naming invited a `date`, and a date has no instant.
model TimeOff {
  id        String   @id @default(cuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  reason    String?  @db.VarChar(255)
  // No updatedAt: an absence is recorded or removed, never edited. Changing one
  // is a remove plus an add.
  createdAt DateTime @default(now())

  // Identity is the barber plus the two boundaries. This is what makes a
  // retried create idempotent: unlike the weekly schedule there is no
  // replacement semantics here, so without it a retry after a
  // committed-but-timed-out save would insert a duplicate.
  @@unique([barberId, startsAt, endsAt])
  // Backs the editor list (ordered by startsAt) and the availability lookup.
  @@index([barberId, startsAt])
}

/// How the deposit that confirms a booking is computed (data-model.md §14).
enum DepositType {
  FIXED
  PERCENT
}

/// The owner's shared payment configuration, applied across all locations
/// (data-model.md §14).
///
/// Unlike every other entity here, this is a SINGLE ROW written by three
/// separate stories: PC1 the transfer destination, PC2 the Mercado Pago
/// credentials, PC3 the deposit policy. Two consequences are load-bearing:
///
/// 1. The whole table is created in one migration, including the columns PC2
///    and PC3 will use. A single-row entity assembled across three migrations
///    is three chances for the three stories to disagree about its shape, and
///    each later migration would ALTER a table already holding live payment
///    data (PC1 design D1).
/// 2. Every write MUST name only its own columns. A whole-entity write would
///    silently reset the other two stories' columns while reporting success —
///    the worst shape a data bug can take (PC1 design D5).
///
/// The row is created by the owner's first save. No migration, seed or
/// provisioning script may create it.
model PaymentConfig {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   Owner  @relation(fields: [ownerId], references: [id])

  /// PC2. Encrypted at rest and never sent to the browser. It shares this row
  /// with data the public flow must read, which is why reads serving that flow
  /// use a narrow projection rather than the entity (design D7).
  mpAccessToken String?
  mpPublicKey   String?

  /// Digits only, exactly 22, check digits verified before persistence. Stored
  /// normalized rather than as typed, so two spellings of one account cannot
  /// become two different stored strings (design D3).
  transferCbuCvu     String? @db.VarChar(30)
  /// Trimmed and lowercased — the alias namespace is case-insensitive and
  /// canonically lowercase (design D4).
  transferAlias      String? @db.VarChar(60)
  /// Nullable at the column level only because the whole transfer destination
  /// is optional. Whenever a destination is present this is REQUIRED, enforced
  /// in the application layer: a client transferring to a bare 22-digit number
  /// cannot confirm they are paying the right business.
  transferHolderName String? @db.VarChar(120)

  depositType  DepositType @default(PERCENT)
  /// Nullable until PC3 sets it, overriding the earlier "required" in
  /// data-model.md §14. The row exists as soon as a transfer destination is
  /// saved, and forcing a value here would make PC1 invent a deposit policy the
  /// owner never chose — "unconfigured" would become indistinguishable from
  /// "configured to that value", and it is money.
  ///
  /// Explicit precision and scale, NEVER Prisma's default Decimal(65,30), per
  /// the convention Service.price established.
  depositValue Decimal?    @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No @@index: `ownerId` is already unique, which backs the only query shape
  // this table has. There is exactly one row per owner.
}

/// The lifecycle of an appointment (data-model.md §11).
///
/// Three of these are **blocking**: PENDING_PAYMENT, PENDING_APPROVAL and
/// CONFIRMED all hold a slot against other clients. The rule that decides which
/// of them removes a time from sale lives in `domain/models/Booking.ts` and is
/// shared by availability (B3) and the no-overlap transaction (B4) — two
/// encodings of it would offer a client a time and then reject them paying for
/// it.
enum BookingStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// Who cancelled a booking. There is no SYSTEM member: a hold that lapses
/// becomes EXPIRED rather than CANCELLED, so an expiry is never attributed to a
/// person who did nothing.
enum CancelledBy {
  OWNER
  CLIENT
}

/// A guest customer. Clients have no accounts and no credentials; they are
/// identified by contact data and deduplicated by email per owner
/// (data-model.md §10).
///
/// **Created by B3 and written by none of it.** `Booking.clientId` is a
/// required foreign key, so this table is not optional scope — it arrives with
/// the booking table or the booking table cannot exist. The deduplication the
/// unique constraint enables belongs to B4.
model Client {
  id        String    @id @default(cuid())
  ownerId   String
  // Restrict, not Cascade: a client row is the identity behind real
  // appointments and real money. It must not disappear because a parent row
  // was removed.
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name      String    @db.VarChar(120)
  email     String    @db.VarChar(255)
  phone     String    @db.VarChar(30)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  // Dedup key for returning clients (data-model.md §10). Per owner, not global:
  // the same person booking at two unrelated barbershops is two client records,
  // because neither owner may see the other's customer list.
  @@unique([ownerId, email])
}

/// A single appointment — the central entity of the system (data-model.md §11).
///
/// **Created by B3, which reads it and writes nothing.** The write path, the
/// hold and the transactional no-overlap check are B4's. The table is created
/// whole rather than assembled across stories, following the precedent
/// PaymentConfig set: an entity built up over three migrations is three chances
/// for those stories to disagree about its shape.
///
/// The interval is **half-open**: `[startTime, endTime)`, matching TimeOff so
/// availability never has to reconcile two meanings of a boundary.
model Booking {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Restrict)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  /// Zone-aware, and load-bearing. Prisma's default for DateTime is a
  /// zone-LESS `TIMESTAMP`, which is harmless for createdAt and wrong for
  /// anything compared against a human's clock. data-model.md names inheriting
  /// that default by omission as the failure mode the convention exists to
  /// prevent — so it is declared here at creation, not corrected later.
  startTime DateTime @db.Timestamptz(3)
  /// Derived from startTime + service.durationMinutes at creation, and stored
  /// rather than recomputed: the service's duration can change afterwards, and
  /// an appointment's length is a fact about the appointment.
  endTime   DateTime @db.Timestamptz(3)

  status BookingStatus @default(PENDING_PAYMENT)

  /// Snapshots, not live lookups. Explicit precision and scale, NEVER Prisma's
  /// default Decimal(65,30), per the convention Service.price established. Both
  /// cross the repository boundary as canonical strings: the driver returns a
  /// stored 2000.50 as 2000.5, and integer-cent arithmetic then reads the lone
  /// 5 as five centavos (measured in PC3, documented for Service.price in M3).
  priceAtBooking Decimal @db.Decimal(12, 2)
  /// Calculated once from the policy in force at creation and never recomputed.
  /// A later change to the deposit policy does not alter this booking in any
  /// status — recomputing would reject a client paying a checkout created
  /// moments before the owner edited the policy (data-model.md §11).
  depositAmount  Decimal @db.Decimal(12, 2)

  /// Unguessable, and the client's only credential for cancelling. Unique so a
  /// collision is a write failure rather than one client cancelling another's
  /// appointment.
  cancellationToken String @unique

  /// When the provisional hold lapses. Optional because a CONFIRMED booking has
  /// no hold to expire.
  ///
  /// Availability treats a PENDING_PAYMENT booking past this instant as NOT
  /// blocking, because B7 — the job that sweeps lapsed holds — ships four
  /// stories after B3. Without that clause every abandoned checkout would block
  /// its slot forever with nothing to explain it to the owner.
  holdExpiresAt DateTime?    @db.Timestamptz(3)
  cancelledAt   DateTime?    @db.Timestamptz(3)
  cancelledBy   CancelledBy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Serves both sides of this table's life: B3's "which bookings overlap this
  // range for this barber" read, and B4's transactional no-overlap check. A
  // partial index on the blocking statuses was considered and rejected as
  // premature — it would optimize a predicate B7 may still refine.
  //
  // The read also needs a LOWER bound on startTime to use this index at both
  // ends. Measured with EXPLAIN: with only `startTime < rangeEnd`, `endTime`
  // lands in Filter and the scan walks every earlier row of that barber. The
  // repository bounds it by MAX_DURATION_MINUTES, which is safe only while that
  // cap is enforced on write — raise the cap and the read must widen with it.
  @@index([barberId, startTime])

  // THIS TABLE ALSO CARRIES A CHECK CONSTRAINT THAT PRISMA CANNOT DECLARE:
  //
  //   Booking_pending_payment_requires_hold_expiry
  //     CHECK (status <> 'PENDING_PAYMENT' OR "holdExpiresAt" IS NOT NULL)
  //
  // Added in migration 20260817104600_booking_hold_requires_expiry. Availability
  // treats a null holdExpiresAt on a PENDING_PAYMENT row as blocking, and B7
  // sweeps on `holdExpiresAt < now` — which is false for null — so without the
  // constraint that combination is a permanent silent lock on the slot.
  //
  // `prisma db push` and any schema-only reasoning will not see it. It lives in
  // the migration; this comment exists so the schema file is not mistaken for
  // the whole truth.
}
